rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {uid}
    // Fields:
    //   - uid: string (required)
    //   - username: string (required, < 50 chars)
    //   - email: string (required)
    //   - createdAt: timestamp (required)
    //
    // Collection: puzzle_sessions
    // Document ID: auto-generated
    // Fields:
    //   - userId: string (required)
    //   - username: string (required)
    //   - algorithm: string (required)
    //   - moves: int (required)
    //   - nodesExplored: int (required)
    //   - time: number (required)
    //   - initialState: list (required)
    //   - gridSize: string (required)
    //   - solvedAt: timestamp (required)
    //   - score: int (required)
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'username', 'email', 'createdAt']) &&
             data.uid == request.auth.uid &&
             data.username is string && data.username.size() > 0 && data.username.size() < 50 &&
             data.email is string && data.email.size() > 0;
    }

    function isValidSession(data) {
      return data.keys().hasAll(['userId', 'username', 'algorithm', 'moves', 'nodesExplored', 'time', 'initialState', 'gridSize', 'solvedAt', 'score']) &&
             data.userId == request.auth.uid &&
             data.moves is int && data.moves >= 0 &&
             data.nodesExplored is int && data.nodesExplored >= 0 &&
             data.time is number && data.time >= 0 &&
             data.initialState is list &&
             data.score is int;
    }

    // Rules
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && isValidUser(request.resource.data);
      allow update: if isOwner(uid) && isValidUser(request.resource.data) && 
                      request.resource.data.createdAt == resource.data.createdAt;
    }

    match /puzzle_sessions/{sessionId} {
      allow read: if true; // Publicly readable for leaderboard and history
      allow create: if isAuthenticated() && isValidSession(request.resource.data);
      allow update, delete: if false; // Sessions are immutable
    }
  }
}
